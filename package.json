{
  "name": "chichess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "preview": "vite preview",
    "precommit": "oxlint . && oxfmt . --check && tsc -b"
  },
  "dependencies": {
    "antd": "^6.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
